NEXT_PUBLIC_SHOPIFY_API_KEY=replace-with-your-app-client-id
SHOPIFY_API_SECRET=replace-with-your-app-client-secret
# V0.6 BestTrack live tracking: server-side only; never prefix these with NEXT_PUBLIC_.
BESTTRACK_TRACKING_API_URL=https://api.example.com/v1/tracking
BESTTRACK_API_TOKEN=replace-with-your-besttrack-service-token
# V0.8 Shopify resources: the Next.js route verifies the embedded session and
# calls this trusted BFF. Do not expose either value to the browser.
SHOPIFY_RESOURCE_RUNTIME_URL=https://api.example.com/page-builder/shopify-resources
SHOPIFY_RESOURCE_RUNTIME_TOKEN=replace-with-your-resource-runtime-token
