{
  "name": "@standhigher/besttrack-page-extension",
  "version": "0.5.34",
  "description": "BestTrack business extension entry point for @standhigher/puck-page-builder.",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/validation.ts src/admin.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standhigher/puck-page-builder": "workspace:*",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@shopify/polaris-icons": "^9.3.1",
    "react": "^18.0.0"
  }
}
