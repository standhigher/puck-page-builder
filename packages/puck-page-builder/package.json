{
  "name": "@standhigher/puck-page-builder",
  "version": "0.12.3",
  "description": "React PageDocument editor, extension registry, and web renderer for BestTrack page experiences.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standhigher/puck-page-builder.git"
  },
  "bugs": {
    "url": "https://github.com/standhigher/puck-page-builder/issues"
  },
  "homepage": "https://github.com/standhigher/puck-page-builder#readme",
  "files": [
    "dist",
    "src/styles.css",
    "src/ui/builder/tokens.css",
    "README.md"
  ],
  "sideEffects": [
    "./src/styles.css",
    "./src/ui/builder/tokens.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/renderer.ts src/runtime.ts src/extensions.ts src/schema.ts src/theme.ts --format esm --dts --clean && node scripts/assert-runtime-boundary.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@puckeditor/core": "^0.23.0",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@puckeditor/core": "^0.23.0",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
